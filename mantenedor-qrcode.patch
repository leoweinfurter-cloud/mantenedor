new file mode 100644
index 0000000..00ec62e
--- /dev/null
+++ b/migracao_qrcode_ativos.sql
@@ -0,0 +1,153 @@
+-- ═══════════════════════════════════════════════════════════════════════
+--  Mantenedor — QR Code por ativo (acesso às OS + solicitação pública)
+--  Rodar no SQL Editor do Supabase. Idempotente: pode rodar mais de uma vez.
+--
+--  Diferença para o Caspere: aqui os IDs são inteiros sequenciais e os dados
+--  são multi-tenant. Por isso o QR NÃO carrega o id do ativo e NÃO existe
+--  leitura pública por RLS. O QR carrega um token aleatório (uuid) e o acesso
+--  sem login passa por funções SECURITY DEFINER que devolvem só o mínimo.
+-- ═══════════════════════════════════════════════════════════════════════
+
+-- 1) Token do QR em cada ativo ───────────────────────────────────────────
+-- ADD COLUMN com default volátil gera um valor diferente para cada linha
+-- já existente (backfill automático).
+ALTER TABLE public.ativos
+  ADD COLUMN IF NOT EXISTS qr_token uuid NOT NULL DEFAULT gen_random_uuid();
+
+CREATE UNIQUE INDEX IF NOT EXISTS ativos_qr_token_key ON public.ativos (qr_token);
+
+-- 2) Solicitações abertas por quem leu o QR (sem login) ──────────────────
+CREATE TABLE IF NOT EXISTS public.solicitacoes_qr (
+  id                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id           uuid NOT NULL REFERENCES public.tenants(id) ON DELETE CASCADE,
+  ativo_id            integer NOT NULL REFERENCES public.ativos(id) ON DELETE CASCADE,
+  nome_solicitante    text NOT NULL,
+  contato_solicitante text NOT NULL,
+  descricao           text NOT NULL,
+  status              text NOT NULL DEFAULT 'Pendente'
+                      CHECK (status IN ('Pendente','Convertida','Descartada')),
+  os_id               bigint,
+  criado_em           timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS solicitacoes_qr_tenant_status_idx
+  ON public.solicitacoes_qr (tenant_id, status, criado_em DESC);
+
+ALTER TABLE public.solicitacoes_qr ENABLE ROW LEVEL SECURITY;
+
+-- Equipe logada só enxerga/atualiza as solicitações do próprio tenant.
+-- NÃO há policy de INSERT para anon: a criação só acontece pela função abaixo.
+DROP POLICY IF EXISTS tenant ON public.solicitacoes_qr;
+CREATE POLICY tenant ON public.solicitacoes_qr
+  FOR ALL
+  USING (tenant_id = get_tenant_id())
+  WITH CHECK (tenant_id = get_tenant_id());
+
+-- 3) Visão pública enxuta ────────────────────────────────────────────────
+-- Devolve só: identificação do ativo e as últimas 10 OS concluídas
+-- (sem custos, sem descrição, sem técnico). Token inexistente → NULL.
+DROP FUNCTION IF EXISTS public.qr_ativo_publico(uuid);
+CREATE FUNCTION public.qr_ativo_publico(p_token uuid)
+RETURNS jsonb
+LANGUAGE plpgsql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $func$
+DECLARE
+  v_ativo public.ativos%ROWTYPE;
+  v_os    jsonb;
+BEGIN
+  IF p_token IS NULL THEN
+    RETURN NULL;
+  END IF;
+
+  SELECT * INTO v_ativo FROM public.ativos WHERE qr_token = p_token;
+  IF NOT FOUND THEN
+    RETURN NULL;
+  END IF;
+
+  SELECT COALESCE(jsonb_agg(x ORDER BY x->>'abertura' DESC), '[]'::jsonb)
+    INTO v_os
+    FROM (
+      SELECT jsonb_build_object(
+               'numero_os', o.numero_os,
+               'tipo',      o.tipo,
+               'abertura',  o.abertura
+             ) AS x
+        FROM public.ordens o
+       WHERE o.ativo_id = v_ativo.id
+         AND o.tenant_id = v_ativo.tenant_id
+         AND o.status = 'Concluida'
+       ORDER BY o.abertura DESC NULLS LAST, o.id DESC
+       LIMIT 10
+    ) s;
+
+  RETURN jsonb_build_object(
+    'nome',        v_ativo.nome,
+    'categoria',   v_ativo.categoria,
+    'empresa',     v_ativo.empresa,
+    'unidade',     v_ativo.unidade,
+    'localizacao', v_ativo.localizacao,
+    'tag',         v_ativo.tag,
+    'status',      v_ativo.status,
+    'ultimas_os',  v_os
+  );
+END;
+$func$;
+
+-- 4) Abrir solicitação sem login ─────────────────────────────────────────
+-- Valida tamanhos e limita abuso (máx. 10 pendentes por ativo na última hora).
+-- Retorna 'ok' | 'invalido' | 'nao_encontrado' | 'limite'.
+DROP FUNCTION IF EXISTS public.qr_abrir_solicitacao(uuid, text, text, text);
+CREATE FUNCTION public.qr_abrir_solicitacao(
+  p_token     uuid,
+  p_nome      text,
+  p_contato   text,
+  p_descricao text
+)
+RETURNS text
+LANGUAGE plpgsql
+VOLATILE
+SECURITY DEFINER
+SET search_path = public
+AS $func$
+DECLARE
+  v_ativo public.ativos%ROWTYPE;
+  v_nome  text := btrim(coalesce(p_nome, ''));
+  v_cont  text := btrim(coalesce(p_contato, ''));
+  v_desc  text := btrim(coalesce(p_descricao, ''));
+BEGIN
+  IF p_token IS NULL
+     OR char_length(v_nome) NOT BETWEEN 2 AND 120
+     OR char_length(v_cont) NOT BETWEEN 3 AND 120
+     OR char_length(v_desc) NOT BETWEEN 5 AND 2000 THEN
+    RETURN 'invalido';
+  END IF;
+
+  SELECT * INTO v_ativo FROM public.ativos WHERE qr_token = p_token;
+  IF NOT FOUND THEN
+    RETURN 'nao_encontrado';
+  END IF;
+
+  IF (SELECT count(*) FROM public.solicitacoes_qr
+       WHERE ativo_id = v_ativo.id
+         AND status = 'Pendente'
+         AND criado_em > now() - interval '1 hour') >= 10 THEN
+    RETURN 'limite';
+  END IF;
+
+  INSERT INTO public.solicitacoes_qr
+    (tenant_id, ativo_id, nome_solicitante, contato_solicitante, descricao)
+  VALUES
+    (v_ativo.tenant_id, v_ativo.id, v_nome, v_cont, v_desc);
+
+  RETURN 'ok';
+END;
+$func$;
+
+-- 5) Permissões: só estas duas funções ficam acessíveis sem login ────────
+REVOKE ALL ON FUNCTION public.qr_ativo_publico(uuid) FROM PUBLIC;
+REVOKE ALL ON FUNCTION public.qr_abrir_solicitacao(uuid, text, text, text) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.qr_ativo_publico(uuid) TO anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.qr_abrir_solicitacao(uuid, text, text, text) TO anon, authenticated;
