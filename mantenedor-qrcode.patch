+// ── ETIQUETA QR CODE DO ATIVO ─────────────────────────────────────────
+// O QR guarda só o link /qr.html?t=<token>. O token fica em ativos.qr_token
+// (gerado no banco) e é buscado na hora de montar a etiqueta — não vai para
+// o localStorage nem para o array local de ativos.
+function mostrarQr(ativoId){
+  var a=ativos.find(function(x){return x.id==ativoId;});
+  if(!a) return;
+  if(typeof QRCode==="undefined"){mxToast(t("qr_erro_lib"),"error");return;}
+  sbFetch("ativos?id=eq."+encodeURIComponent(ativoId)+"&select=qr_token")
+    .then(function(r){
+      if(!r.ok) throw new Error("HTTP "+r.status);
+      return r.json();
+    })
+    .then(function(rows){
+      var token=rows&&rows[0]&&rows[0].qr_token;
+      if(!token) throw new Error("ativo sem qr_token");
+      preencherEtiquetaQr(a,token);
+    })
+    .catch(function(e){
+      console.error("[QR] falha ao obter o token do ativo",e);
+      mxToast(t("qr_erro_token"),"error");
+    });
+}
+
+function preencherEtiquetaQr(a,token){
+  var set=function(id,txt){document.getElementById(id).textContent=txt||"";};
+  set("qe-cat",a.categoria);
+  set("qe-nome",a.nome);
+  set("qe-local",[a.tag,a.localizacao].filter(Boolean).join(" • "));
+  set("qe-empresa",[a.empresa,a.unidade].filter(Boolean).join(" • "));
+  set("qe-legenda",t("qr_legenda"));
+  set("qe-rodape","ID: "+a.id);
+
+  var aviso=document.getElementById("qr-aviso");
+  if(mxOrigemQrOficial()){aviso.style.display="none";}
+  else{aviso.textContent=t("qr_aviso_origem");aviso.style.display="block";}
+
+  var el=document.getElementById("qr-canvas");
+  el.innerHTML="";
+  new QRCode(el,{text:mxUrlQrAtivo(token),width:220,height:220});
+  openModal("modal-qr");
+}
+
+function imprimirEtiqueta(){
+  document.body.classList.add("mx-printing-label");
+  window.print();
+}
+window.addEventListener("afterprint",function(){document.body.classList.remove("mx-printing-label");});
+
 initApp(render);
