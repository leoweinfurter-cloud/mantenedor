+// ═══════════════════════════════════════════════════════════════════════
+//  test_qr.js — QR Code dos ativos (etiqueta, qr.html, login ?next, ordens.html)
+//  Rodar:  npm i jsdom   &&   node test_qr.js
+//  Sem rede: o fetch do Supabase e o QRCode (CDN) são substituídos por stubs.
+// ═══════════════════════════════════════════════════════════════════════
+const fs = require("fs");
+const path = require("path");
+const { JSDOM, VirtualConsole } = require("jsdom");
+
+const ROOT = __dirname;
+const UUID = "0f3c9a1e-5b7d-4c2a-9e8f-1a2b3c4d5e6f";
+const HOST = "https://mantenedor.app.br";
+
+let ok = 0, fail = 0;
+const falhas = [];
+async function test(nome, fn){
+  try { await fn(); ok++; console.log("  ✓ " + nome); }
+  catch(e){ fail++; falhas.push(nome); console.log("  ✗ " + nome + "\n      " + (e && e.message)); }
+}
+function assert(cond, msg){ if(!cond) throw new Error(msg || "assert falhou"); }
+function eq(a, b, msg){ if(a !== b) throw new Error((msg||"eq") + ": esperado " + JSON.stringify(b) + ", veio " + JSON.stringify(a)); }
+async function waitFor(cond, ms){
+  const fim = Date.now() + (ms || 2000);
+  while(Date.now() < fim){ if(cond()) return; await new Promise(r => setTimeout(r, 10)); }
+  throw new Error("timeout esperando condição");
+}
+
+// ── infraestrutura ───────────────────────────────────────────────────────
+function jwt(){
+  const b = o => Buffer.from(JSON.stringify(o)).toString("base64url");
+  return b({alg:"HS256"}) + "." + b({exp: 4102444800}) + ".assinatura";
+}
+const SESSAO = (perfil, nome) => ({access_token: jwt(), refresh_token: "r", user_id: "u1", email: "a@b.c",
+  tenant_id: "t-1", perfil: perfil, nome: nome, plano: "paid", tenantNome: "ACME"});
+
+// routes(url, opts) → {status?, body}  |  undefined (→ 200 [])
+function makeFetch(routes){
+  const calls = [];
+  const fn = async (url, opts) => {
+    opts = opts || {};
+    calls.push({url: String(url), method: opts.method || "GET", body: opts.body ? JSON.parse(opts.body) : null, headers: opts.headers || {}});
+    const r = (routes && routes(String(url), opts)) || {body: []};
+    const status = r.status || 200;
+    return {ok: status >= 200 && status < 300, status, statusText: "st",
+            json: async () => (r.body === undefined ? [] : r.body), text: async () => JSON.stringify(r.body)};
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+function loadPage(file, o){
+  let html = fs.readFileSync(path.join(ROOT, file), "utf8");
+  // inline dos scripts locais (jsdom sem carregar arquivos) e remoção de CDN/PWA/tema
+  html = html
+    .replace(/<script src="(_lang|_shared)\.js"><\/script>/g, (m, n) => "<script>" + fs.readFileSync(path.join(ROOT, n + ".js"), "utf8") + "</script>")
+    .replace(/<script src="(_theme|_pwa)\.js"[^>]*><\/script>/g, "")
+    .replace(/<script src="https:[^"]*"[^>]*><\/script>/g, "");
+  const erros = [];
+  const vc = new VirtualConsole();
+  vc.on("jsdomError", e => { if(!/not implemented: navigation/i.test(e.message)) erros.push(e.message); });
+  const dom = new JSDOM(html, {
+    url: o.url, runScripts: "dangerously", pretendToBeVisual: true, virtualConsole: vc,
+    beforeParse(w){
+      if(o.session) w.localStorage.setItem("mx_session", JSON.stringify(o.session));
+      w.fetch = o.fetch;
+      w.confirm = () => true; w.alert = () => {};
+      w.scrollTo = () => {};
+      if(o.qrcode) w.QRCode = o.qrcode;
+    }
+  });
+  dom.erros = erros;
+  return dom;
+}
+// Texto visível da página (sem o conteúdo dos <script>, que inclui as traduções do _lang.js)
+const texto = dom => {
+  const c = dom.window.document.body.cloneNode(true);
+  c.querySelectorAll("script").forEach(e => e.remove());
+  return c.textContent.replace(/\s+/g, " ");
+};
+const toasts = dom => [...dom.window.document.querySelectorAll("#mx-toast-host > div")].map(e => e.textContent);
+
+// ═══════════════════════════════════════════════════════════════════════
+(async () => {
+console.log("\n[1] i18n — toda chave qr_* usada existe em PT/EN/ES");
+await test("chaves usadas nas páginas resolvem nos 3 idiomas", () => {
+  const usadas = new Set();
+  ["qr.html", "ativos.html", "ordens.html"].forEach(f => {
+    (fs.readFileSync(path.join(ROOT, f), "utf8").match(/\bqr_[a-z_]+\b/g) || []).forEach(k => usadas.add(k));
+  });
+  ["qr_token", "qr_ativo_publico", "qr_abrir_solicitacao"].forEach(k => usadas.delete(k)); // coluna/RPC, não chaves
+  assert(usadas.size >= 30, "poucas chaves encontradas: " + usadas.size);
+  const dom = new JSDOM("<body></body>", {url: HOST + "/", runScripts: "outside-only"});
+  dom.window.eval(fs.readFileSync(path.join(ROOT, "_lang.js"), "utf8"));
+  const faltando = [];
+  ["pt", "en", "es"].forEach(l => {
+    dom.window.LANG.set(l);
+    usadas.forEach(k => { if(dom.window.t(k) === k) faltando.push(l + ":" + k); });
+  });
+  assert(!faltando.length, "sem tradução: " + faltando.join(", "));
+});
+
+console.log("\n[2] Helpers de _shared.js e login");
+const shared = new JSDOM("<body></body>", {url: HOST + "/ativos.html", runScripts: "outside-only"});
+shared.window.eval(fs.readFileSync(path.join(ROOT, "_shared.js"), "utf8"));
+const W = shared.window;
+
+await test("mxUrlQrAtivo monta /qr.html?t=<token> e mxOrigemQrOficial", () => {
+  eq(W.mxUrlQrAtivo(UUID), HOST + "/qr.html?t=" + UUID);
+  eq(W.mxUrlQrAtivo(UUID, "http://localhost:8080"), "http://localhost:8080/qr.html?t=" + UUID);
+  assert(W.mxOrigemQrOficial(HOST), "origem oficial");
+  assert(!W.mxOrigemQrOficial("http://localhost:8080"), "localhost não é oficial");
+  assert(!W.mxOrigemQrOficial("https://mantenedor.app.br.evil.com"), "domínio parecido não é oficial");
+});
+
+const ACEITOS = ["qr.html?t=" + UUID, "dashboard.html", "ordens.html?exec=12"];
+const REJEITADOS = ["//evil.com", "https://evil.com", "http:evil.html", "/qr.html", "javascript:alert(1)",
+  "qr.html?t=1\n2", "..\\x.html", "evil.com.html", "qr.html#x", "qr.html?t=<script>", "", "x.html?a=b c"];
+await test("mxProximoSeguro aceita só páginas do app (sem open redirect)", () => {
+  ACEITOS.forEach(v => eq(W.mxProximoSeguro(v), v, "aceito " + v));
+  REJEITADOS.forEach(v => eq(W.mxProximoSeguro(v), "", "rejeitado " + JSON.stringify(v)));
+  eq(W.mxProximoSeguro(null), ""); eq(W.mxProximoSeguro(undefined), "");
+});
+
