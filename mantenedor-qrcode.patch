+  var antes=ordens;
+  ordens=[nova].concat(ordens);
+  try{
+    await saveOrdens(ordens);                 // sbUpsert ja avisa por toast se falhar
+  }catch(e){
+    console.error("[QR] converter: OS nao foi salva",e);
+    ordens=antes;                             // nada foi criado: desfaz o estado local
+    mxToast(t("qr_sol_erro"),"error");
+    render();
+    return;
+  }
+  // A OS ja existe no banco. Se so a marcacao da solicitacao falhar, a OS nao pode
+  // ser desfeita: avisa e tira a solicitacao da tela para nao gerar OS duplicada
+  // por clique repetido (ela reaparece no proximo carregamento — descartar la).
+  try{
+    await atualizarSolicitacao(id,{status:"Convertida",os_id:nova.id});
+  }catch(e){
+    console.error("[QR] converter: OS criada, solicitacao nao marcada",e);
+    mxToast(t("qr_sol_erro_marcar"),"warn");
+  }
+  solicitacoes=solicitacoes.filter(function(x){return x.id!==id;});
+  render();
+}
+
+initApp(function(){ render(); tratarParamsQr(); carregarSolicitacoes(); });
