+// ── QR CODE: parametros de entrada (?exec=ID | ?nova=ATIVO_ID) ───────────
+// qr.html leva a equipe para ca; a logica de "Executar" (Aberta → Em Andamento)
+// e a de nova OS corretiva continuam sendo as mesmas desta pagina.
+function tratarParamsQr(){
+  var p=new URLSearchParams(window.location.search);
+  var exec=p.get("exec"), nova=p.get("nova");
+  if(!exec&&!nova) return;
+  // Limpa a URL para nao repetir a acao ao voltar/recarregar.
+  try{ history.replaceState(null,"",window.location.pathname); }catch(e){}
+  if(exec){
+    var o=ordens.find(function(x){return String(x.id)===String(exec);});
+    if(!o){ mxToast(t("os_nao_encontrada")+" "+exec,"error"); return; }
+    var pode=isCoordenador()||!o.tecnico||o.tecnico===meuNomeAtivo();
+    if(!pode){ mxToast(t("qr_sem_permissao"),"error"); return; }
+    if(o.status=="Aberta"||o.status=="Em Andamento") executarOS(o.id);
+    else window.location.href=ordensDetailUrl(o);
+  } else if(isCoordenador()){
+    var ativoId=parseInt(nova,10);
+    if(!ativos.some(function(a){return a.id===ativoId;})){ mxToast(t("os_ativo_invalido"),"error"); return; }
+    openNewOSCorretiva();
+    document.getElementById("oc-ativo").value=String(ativoId);
+  }
+}
+
+// ── QR CODE: solicitacoes abertas por quem leu o QR sem login ────────────
+// Chegam em solicitacoes_qr (via funcao publica qr_abrir_solicitacao) e
