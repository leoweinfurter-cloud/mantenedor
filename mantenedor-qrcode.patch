+
+    + '<div class="card">'
+    +   '<div style="font-size:14px;font-weight:700;margin-bottom:6px">' + esc(t("qr_abrir_solic")) + '</div>'
+    +   '<p style="font-size:13px;color:#94a3b8;margin-bottom:14px">' + esc(t("qr_solic_intro")) + '</p>'
+    +   '<form id="form-solic" autocomplete="off">'
+    +     '<div class="fg"><label class="lbl">' + esc(t("qr_f_nome")) + '</label><input name="nome" maxlength="120" required/></div>'
+    +     '<div class="fg"><label class="lbl">' + esc(t("qr_f_contato")) + '</label><input name="contato" maxlength="120" required/></div>'
+    +     '<div class="fg"><label class="lbl">' + esc(t("qr_f_desc")) + '</label><textarea name="descricao" rows="4" maxlength="2000" required></textarea></div>'
+    +     '<p id="solic-erro" class="qr-msg-erro" style="display:none"></p>'
+    +     '<p id="solic-ok" class="qr-msg-ok" style="display:none">' + esc(t("qr_solic_ok")) + '</p>'
+    +     '<button type="submit" class="btn bp" style="width:100%" id="btn-solic">' + esc(t("qr_enviar")) + '</button>'
+    +   '</form>'
+    + '</div>';
+
+  var link = document.getElementById("link-equipe");
+  if(link){
+    link.addEventListener("click", function(e){
+      e.preventDefault();
+      window.location.href = "login.html?next=" + encodeURIComponent("qr.html?t=" + qrToken);
+    });
+  }
+  document.getElementById("form-solic").addEventListener("submit", enviarSolicitacao);
+}
+
+function enviarSolicitacao(e){
+  e.preventDefault();
+  var form = e.target;
+  var btn = document.getElementById("btn-solic");
+  var erro = document.getElementById("solic-erro");
+  var ok = document.getElementById("solic-ok");
+  erro.style.display = "none"; ok.style.display = "none";
+  btn.disabled = true; btn.textContent = t("qr_enviando");
+
+  var fd = new FormData(form);
+  rpcPublico("qr_abrir_solicitacao", {
+    p_token: qrToken,
+    p_nome: fd.get("nome"),
+    p_contato: fd.get("contato"),
+    p_descricao: fd.get("descricao")
+  }).then(function(res){
+    if(res === "ok"){
+      ok.style.display = "block";
+      form.reset();
+    } else {
+      var chave = res === "limite" ? "qr_solic_limite" : res === "nao_encontrado" ? "qr_nao_encontrado" : "qr_solic_invalido";
+      erro.textContent = t(chave); erro.style.display = "block";
+    }
+  }).catch(function(){
+    erro.textContent = t("qr_erro_rede"); erro.style.display = "block";
+  }).then(function(){
+    btn.disabled = false; btn.textContent = t("qr_enviar");
+  });
+}
+
+// ── CARREGAMENTO ─────────────────────────────────────────────────────────
+function carregarPublico(){
+  return rpcPublico("qr_ativo_publico", {p_token: qrToken}).then(function(dados){
+    if(!dados){ mostrarErro("qr_nao_encontrado"); return; }
+    state = {fase: "publico", ativo: dados};
+    render();
+  }).catch(function(){ mostrarErro("qr_erro_rede"); });
+}
+
+function carregarEquipe(){
+  // Respeita o RLS: só devolve linha se o ativo for do tenant de quem está logado.
+  return sbFetch("ativos?qr_token=eq." + qrToken + "&select=id,nome,categoria,empresa,unidade,localizacao,tag,status")
+    .then(function(r){
+      if(r.status === 401){ localStorage.removeItem("mx_session"); return null; }
+      if(!r.ok) return null;
+      return r.json();
+    })
+    .then(function(rows){
+      if(!rows || !rows.length) return null;
+      var ativo = rows[0];
+      var filtro = "ativo_id=eq." + ativo.id + "&status=in.(Aberta," + encodeURIComponent('"Em Andamento"') + ")";
+      return sbFetch("ordens?" + filtro + "&select=id,numero_os,titulo,tipo,prioridade,status,tecnico,origem,prazo&order=abertura.desc")
+        .then(function(r){ return r.ok ? r.json() : []; })
+        .then(function(os){ return {ativo: ativo, os: os}; });
+    })
+    .catch(function(){ return null; });
+}
+
+function iniciar(){
+  if(!UUID_RE.test(qrToken)){ mostrarErro("qr_sem_token"); return; }
+  var s = getSession();
+  if(s && s.access_token && s.tenant_id){
+    carregarEquipe().then(function(res){
+      if(res){ state = {fase: "equipe", ativo: res.ativo, os: res.os}; render(); }
+      else carregarPublico();
+    });
+  } else {
+    carregarPublico();
+  }
+}
+
+window.addEventListener("langchange", function(){ LANG.applyStatic(); render(); });
+iniciar();
+</script>
+<script src="_theme.js"></script>
+</body>
