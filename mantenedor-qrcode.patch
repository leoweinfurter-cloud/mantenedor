+var solicitacoes=[];
+function carregarSolicitacoes(){
+  if(!isCoordenador()) return Promise.resolve();
+  return sbFetch("solicitacoes_qr?status=eq.Pendente&select=*&order=criado_em.desc")
+    .then(function(r){ return r.ok?r.json():[]; })
+    .then(function(rows){ solicitacoes=Array.isArray(rows)?rows:[]; render(); })
+    .catch(function(e){ console.warn("[QR] solicitacoes",e); });
+}
+function renderSolicitacoes(){
+  if(!isCoordenador()||!solicitacoes.length) return "";
+  var itens=solicitacoes.map(function(s){
