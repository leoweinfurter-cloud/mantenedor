+      +'</div></div>';
+  }).join("");
+  return'<div class="card" style="border-color:#fbbf2440;margin-bottom:16px">'
+    +'<div class="st" style="margin-bottom:12px">&#9783; '+esc(t("qr_sol_titulo"))+' ('+solicitacoes.length+')</div>'
+    +itens+'</div>';
+}
+function atualizarSolicitacao(id,campos){
+  return sbFetch("solicitacoes_qr?id=eq."+encodeURIComponent(id),{method:"PATCH",body:JSON.stringify(campos)})
+    .then(function(r){ if(!r.ok) throw new Error("HTTP "+r.status); });
+}
+function descartarSolicitacao(id){
+  if(!confirm(t("qr_sol_conf_descartar"))) return;
+  atualizarSolicitacao(id,{status:"Descartada"}).then(function(){
+    solicitacoes=solicitacoes.filter(function(s){return s.id!==id;});
+    render();
+  }).catch(function(e){ console.error("[QR] descartar",e); mxToast(t("qr_sol_erro"),"error"); });
+}
+async function converterSolicitacao(id){
+  var s=solicitacoes.find(function(x){return x.id===id;});
+  if(!s) return;
+  var a=ativos.find(function(x){return x.id===s.ativo_id;});
+  if(!a){ mxToast(t("os_ativo_invalido"),"error"); return; }
+  var desc=s.descricao+"\n\n"+t("qr_sol_de")+": "+s.nome_solicitante+" ("+s.contato_solicitante+")";
